# Resend API Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email Configuration
# The email address that will receive contact form submissions
EMAIL_TO=info@rupamallcarwash.co.ke

# The "from" email address (must be a verified domain in Resend)
EMAIL_FROM=noreply@rupamallcarwash.co.ke

# Google Maps Embed API (Optional - for map customization)
# Get API key from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Places API (for Google Reviews)
# Get API key from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Your Google Place ID (find it at: https://developers.google.com/maps/documentation/places/web-service/place-id)
NEXT_PUBLIC_GOOGLE_PLACE_ID=your_place_id_here

# Site Configuration
NEXT_PUBLIC_SITE_NAME="Rupa's Mall Car Wash"
NEXT_PUBLIC_BUSINESS_PHONE="+254712345678"
NEXT_PUBLIC_BUSINESS_EMAIL="info@rupamallcarwash.co.ke"
NEXT_PUBLIC_BUSINESS_ADDRESS="Westlands, Nairobi, Kenya"
